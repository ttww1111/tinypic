{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TinyPic",
  "version": "0.1.0",
  "identifier": "com.tinypic.tinypic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "小图",
        "width": 520,
        "height": 360,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {}
    }
  }
}
